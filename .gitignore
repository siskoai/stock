# Binaires et artefacts de compilation
/build/bin/
/build/windows/installer/tmp/
/build/windows/icon.ico
/build/darwin/iconfile.icns
/Comptoir
/comptoir
*.exe
*.syso

# Interface compilée : régénérée par « wails build ».
# Le dossier lui-même reste versionné : //go:embed exige qu'il existe pour que
# « go build » et « go test » fonctionnent sans avoir compilé le frontend.
/frontend/dist/*
!/frontend/dist/.gitkeep
/frontend/node_modules/
/frontend/wailsjs/
/frontend/package.json.md5

# Données locales, jamais versionnées
/data/
/backups/
/exports/
*.log

# Systèmes
.DS_Store
Thumbs.db
